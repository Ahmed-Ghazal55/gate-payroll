<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Include generated assets explicitly, including on the first clean build. -->
    <Content Remove="wwwroot/app.js;wwwroot/table-tools.js;wwwroot/bootstrap.js;wwwroot/rider-form.js;wwwroot/rider-form.html" />
    <Content Include="wwwroot/app.js;wwwroot/table-tools.js;wwwroot/bootstrap.js;wwwroot/rider-form.js;wwwroot/rider-form.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="App_Data/**;appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="BuildChoiceFrontend" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="../RiderForm" Command="npm run build:all" />
    <Copy SourceFiles="../RiderForm/web/rider-form.html" DestinationFiles="wwwroot/rider-form.html" />
  </Target>
</Project>
