# Reference only: .NET does not automatically load .env files.
ASPNETCORE_ENVIRONMENT=Production
# Set the real host in the hosting panel, without scheme or path.
AllowedHosts=payroll.your-domain.example
# Use a durable absolute path outside Payroll.Api/wwwroot.
PAYROLL_DATA_DIR=D:/site/private-payroll-data
# Generate a new secret with scripts/production_settings.py. No default key is accepted.
PAYROLL_BOOTSTRAP_KEY=
# Additional trusted reverse-proxy IPs only. Loopback remains trusted for IIS.
PAYROLL_KNOWN_PROXIES=

# Optional HTTPS origin for permanent sharing links. AllowedHosts still must be configured.
# Payroll__PublicBaseUrl=https://payroll.your-domain.example
# Optional SQL Server connection string: configure privately in the hosting panel.
# ConnectionStrings__DefaultConnection=
