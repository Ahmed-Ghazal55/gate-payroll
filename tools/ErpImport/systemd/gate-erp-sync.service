[Unit]
Description=Read-only ERP facts to Gate staging (counts-only audit log)
ConditionPathExists=%h/Private/gate-data/erp-readonly.env
ConditionPathExists=%h/Private/gate-data/staging.env

[Service]
Type=oneshot
WorkingDirectory=%h/gate-sync
ExecStart=/usr/bin/env dotnet %h/gate-sync/ErpImport.dll --live --commit --consistent --counts-only
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=30min
